---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/barlow-condensed/300.css';
import '@fontsource/barlow-condensed/400.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import Player from '../components/Player.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Pedro Henrique Bohn Costa',
  description = 'Portfólio de Pedro Henrique Bohn Costa: Full Stack, game dev e segurança ofensiva.',
} = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0b0d" />
    <title>{title}</title>
    <script is:inline data-astro-rerun>
      try {
        if (sessionStorage.getItem('vd-entered')) document.documentElement.classList.add('entered');
      } catch (e) {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Menu />
    <Player transition:persist />
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>

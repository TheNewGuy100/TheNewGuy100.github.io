---
import { linguagens, contextos } from '../data/perfil';
import type { Contexto } from '../data/perfil';
import { iconPath } from '../lib/icons';
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';

const lang = getLang(Astro.url);
const t = ui(lang);
const ordem: Contexto[] = ['producao', 'projetos', 'estudo'];
---
<section id="linguagens" class="wrap sec">
  <div class="head">
    <p class="kicker">{t.linguagens.kicker}</p>
    <ul class="legend" aria-label={t.linguagens.legenda}>
      {ordem.map((c) => (
        <li><span class="dot" style={`background:${contextos[c].cor}`}></span>{t.linguagens.contextos[c]}</li>
      ))}
    </ul>
  </div>
  <ul class="grid">
    {linguagens.map((l) => {
      const cor = contextos[l.contexto].cor;
      const path = iconPath(l.slug);
      return (
        <li class="card" style={`--cor:${cor}`}>
          <span class="ic" aria-hidden="true">
            {path ? <svg viewBox="0 0 24 24"><path d={path} fill="currentColor" /></svg> : <span class="mono">{l.mono}</span>}
          </span>
          <span class="txt">
            <strong>{l.nome}</strong>
            <span class="lv">{t.linguagens.contextos[l.contexto]}</span>
            {l.provas.length > 0 && <span class="proof">{l.provas.join(' · ')}</span>}
          </span>
          <span class="bar" aria-hidden="true"></span>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .sec {
    padding-top: 90px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 22px;
    font-size: 13px;
    color: var(--muted);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .grid {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
    height: 104px;
    padding: 0 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  .ic {
    flex: none;
    width: 36px;
    display: grid;
    place-items: center;
  }
  svg {
    width: 36px;
    height: 36px;
  }
  .mono {
    font: 600 22px var(--mono);
  }
  .txt {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  strong {
    font: 500 18px var(--body);
  }
  .lv {
    font: 400 11px var(--mono);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--cor);
  }
  .proof {
    font: 400 11px/1.3 var(--mono);
    color: var(--muted);
  }
  .txt {
    min-width: 0;
  }
  .bar {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--cor);
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 768px) {
    .sec {
      padding-top: 56px;
    }
    .grid {
      gap: 12px;
      margin-top: 24px;
    }
    .card {
      height: 88px;
      padding-inline: 16px;
      gap: 12px;
    }
    svg {
      width: 28px;
      height: 28px;
    }
    .ic {
      width: 28px;
    }
    strong {
      font-size: 15px;
    }
    .lv {
      font-size: 10px;
    }
    .legend {
      gap: 12px;
      font-size: 12px;
    }
  }
</style>

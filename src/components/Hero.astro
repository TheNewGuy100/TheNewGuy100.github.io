---
import { getCollection } from 'astro:content';
import { getLang, href } from '../i18n';
import { ui } from '../i18n/ui';
import { links } from '../data/contato';
import { herois, HeroPadrao } from './heroes';

const lang = getLang(Astro.url);
const t = ui(lang);

// O destaque é o projeto com `atualizado` mais recente; sem nenhuma data, o primeiro da ordem.
const todos = await getCollection('projetos');
const comData = todos.filter((p) => p.data.atualizado);
const recente =
  [...comData].sort((a, b) => b.data.atualizado!.getTime() - a.data.atualizado!.getTime())[0] ??
  [...todos].sort((a, b) => a.data.ordem - b.data.ordem)[0];

// Cada projeto pode ter um herói dedicado (ver `heroes/index.ts`); os demais usam o padrão.
const Destaque = herois[recente.id] ?? HeroPadrao;
const sociais = links.filter((l) => l.chave === 'linkedin' || l.chave === 'github');
---
<section class="hero" aria-label={t.hero.ultimo}>
  <Destaque projeto={recente} />

  <div class="id wrap">
    <div class="who">
      <p class="kicker">{t.hero.kicker}</p>
      <h1 class="display name">Pedro Henrique Bohn Costa.</h1>
      <p class="role">{t.hero.stackLine}</p>
    </div>
    <div class="now">
      <p class="present"><span class="dot" aria-hidden="true"></span>{t.hero.atual}</p>
      <ul class="quick">
        {sociais.map((l) => (
          <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.rotulo} <span aria-hidden="true">↗</span></a></li>
        ))}
        <li><a href={href(lang, '/#contato')}>{t.hero.contato} <span aria-hidden="true">↓</span></a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - var(--header));
    min-height: calc(100svh - var(--header));
  }

  /* Faixa de identidade: ocupa o que sobra da primeira tela. */
  .id {
    flex: 1;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
    padding-block: 28px;
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .name {
    font-size: clamp(44px, 6.4vw, 96px);
    line-height: 0.95;
  }
  .role {
    margin: 0;
    font: 400 14px var(--mono);
    letter-spacing: 1.5px;
    color: var(--muted);
  }
  .now {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
    font: 400 13px var(--mono);
  }
  .present {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .quick {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 22px;
    color: var(--muted);
  }
  .quick a:hover {
    color: var(--accent);
  }

  @media (max-width: 960px) {
    .id {
      flex-direction: column;
      align-items: flex-start;
      gap: 22px;
    }
    .now {
      align-items: flex-start;
    }
  }
  @media (max-width: 768px) {
    .quick {
      gap: 16px;
    }
  }
</style>

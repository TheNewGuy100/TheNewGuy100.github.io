---
import { sobre, experiencia, formacao } from '../data/perfil';
---
<section id="sobre" class="wrap sec">
  <p class="kicker">01 / Sobre</p>
  <p class="display lead">{sobre}</p>

  <p class="label sub">Experiência</p>
  <ol class="exp">
    {experiencia.map((e) => (
      <li>
        <time>{e.periodo}</time>
        <strong>{e.cargo}</strong>
        <span>{e.empresa}</span>
      </li>
    ))}
  </ol>

  <p class="label sub">Formação</p>
  <ul class="edu">
    {formacao.map((f) => <li>{f}</li>)}
  </ul>
</section>

<style>
  .sec {
    padding-top: 80px;
    padding-bottom: 72px;
  }
  .lead {
    font-size: clamp(34px, 4.4vw, 64px);
    line-height: 1.05;
    max-width: 900px;
    margin: 36px 0 56px;
  }
  .sub {
    margin-bottom: 18px;
  }
  .exp {
    list-style: none;
    padding: 0;
    margin: 0 0 48px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .exp li {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  time {
    font: 400 13px var(--mono);
    color: var(--accent);
  }
  strong {
    font: 500 18px/1.3 var(--body);
  }
  .exp span {
    color: var(--muted);
  }
  .edu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
  }
  @media (max-width: 960px) {
    .exp {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 768px) {
    .sec {
      padding-top: 48px;
      padding-bottom: 40px;
    }
    .lead {
      margin: 24px 0 40px;
    }
    .exp {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .exp li {
      padding: 14px 0;
      border-top: 1px solid var(--border);
    }
    strong {
      font-size: 16px;
    }
    .edu {
      flex-direction: column;
      gap: 14px;
      font-size: 14px;
    }
  }
</style>

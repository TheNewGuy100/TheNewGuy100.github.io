---
---
<header class="site">
  <div class="bar">
    <button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="menu" data-menu-open>
      <span aria-hidden="true">≡</span> Menu
    </button>
    <a class="brand" href="/" aria-label="Pedro Bohn, início">PEDRO BOHN</a>
    <div class="right">
      <span class="lang" title="Português">PT</span>
      <button class="som" type="button" data-sound-toggle aria-pressed="false">
        <span aria-hidden="true">♪</span> <span data-sound-label>som off</span>
      </button>
    </div>
  </div>
</header>

<style>
  header.site {
    border-bottom: 1px solid var(--border);
  }
  .bar {
    max-width: 1440px;
    margin: 0 auto;
    height: var(--header);
    padding-inline: var(--pad);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .menu-btn {
    justify-self: start;
    font: 500 15px var(--body);
  }
  .brand {
    font: 600 22px var(--display);
    letter-spacing: 6px;
  }
  .right {
    justify-self: end;
    display: flex;
    gap: 24px;
    font: 500 13px var(--mono);
  }
  .som {
    font: 400 13px var(--mono);
    color: var(--muted);
  }
  .som.is-on {
    color: var(--accent);
  }
  @media (max-width: 768px) {
    .brand {
      font-size: 18px;
      letter-spacing: 4px;
    }
    .lang {
      display: none;
    }
    .menu-btn {
      font-size: 14px;
    }
  }
</style>

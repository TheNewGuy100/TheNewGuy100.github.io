---
import { getLang, langs, langNames, stripLang, href } from '../i18n';
import { ui } from '../i18n/ui';

const lang = getLang(Astro.url);
const t = ui(lang);
const base = stripLang(Astro.url.pathname);
---
<header class="site">
  <div class="bar">
    <button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="menu" data-menu-open>
      <span aria-hidden="true">≡</span> {t.header.menu}
    </button>
    <a class="brand" href={href(lang, '/')} aria-label={t.header.inicioAria}>PEDRO BOHN</a>
    <nav class="lang" aria-label={t.header.idioma}>
      {langs.map((l) => (
        <a
          href={href(l, base)}
          lang={l}
          hreflang={l}
          title={langNames[l]}
          data-lang-choice={l}
          aria-current={l === lang ? 'true' : undefined}
          class:list={{ on: l === lang }}
        >{l.toUpperCase()}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  header.site {
    border-bottom: 1px solid var(--border);
  }
  .bar {
    max-width: 1440px;
    margin: 0 auto;
    height: var(--header);
    padding-inline: var(--pad);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .menu-btn {
    justify-self: start;
    font: 500 15px var(--body);
  }
  .brand {
    font: 600 22px var(--display);
    letter-spacing: 6px;
  }
  .lang {
    justify-self: end;
    display: flex;
    gap: 18px;
    font: 500 13px var(--mono);
    color: var(--muted);
  }
  .lang a {
    padding-block: 6px;
  }
  .lang a:hover {
    color: var(--text);
  }
  .lang a.on {
    color: var(--accent);
  }
  @media (max-width: 768px) {
    .brand {
      font-size: 18px;
      letter-spacing: 4px;
    }
    .lang {
      gap: 10px;
      font-size: 12px;
    }
    .menu-btn {
      font-size: 14px;
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import { links, curriculo, emailB64 } from '../data/contato';
import { getLang, langs, langNames, stripLang, href, pad } from '../i18n';
import { ui } from '../i18n/ui';

const lang = getLang(Astro.url);
const t = ui(lang);
const base = stripLang(Astro.url.pathname);
const total = (await getCollection('projetos')).length;
const items = [
  { n: '01', rotulo: t.nav.inicio, desc: t.nav.inicioDesc, href: href(lang, '/'), ativo: base === '/' },
  { n: '02', rotulo: t.nav.sobre, desc: t.nav.sobreDesc, href: href(lang, '/#sobre'), ativo: false },
  { n: '03', rotulo: t.nav.projetos, desc: t.nav.projetosDesc(total).replace(String(total), pad(total)), href: href(lang, '/projetos/'), ativo: base.startsWith('/projetos') },
  { n: '04', rotulo: t.nav.stack, desc: t.nav.stackDesc, href: href(lang, '/#stack'), ativo: false },
  { n: '05', rotulo: t.nav.contato, desc: t.nav.contatoDesc, href: href(lang, '/#contato'), ativo: false },
];
---
<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu" aria-hidden="true">
  <div class="top">
    <button class="close" type="button" data-menu-close><span aria-hidden="true">✕</span> {t.header.fechar}</button>
    <span class="brand">PEDRO BOHN</span>
    <nav class="lang" aria-label={t.header.idioma}>
      {langs.map((l) => (
        <a href={href(l, base)} lang={l} hreflang={l} title={langNames[l]} data-lang-choice={l} aria-current={l === lang ? 'true' : undefined} class:list={{ on: l === lang }}>{l.toUpperCase()}</a>
      ))}
    </nav>
  </div>
  <div class="body">
    <nav class="items" aria-label={t.nav.aria}>
      {items.map((i) => (
        <a class:list={['item', { ativo: i.ativo }]} href={i.href} aria-current={i.ativo ? 'page' : undefined}>
          <span class="num">{i.n}</span>
          <span class="name">{i.rotulo}</span>
          <span class="desc">{i.desc}</span>
          {i.ativo && <span class="arrow" aria-hidden="true">→</span>}
        </a>
      ))}
    </nav>
    <aside class="panel">
      <p class="label">{t.nav.contato}</p>
      <ul class="contacts">
        {links.map((l) => (
          <li><span class="key">{l.chave}</span><a href={l.href} target="_blank" rel="noopener noreferrer">{l.rotulo} <span aria-hidden="true">↗</span></a></li>
        ))}
        <li><span class="key">email</span><span class="email-line"><button type="button" class="reveal" data-email-reveal data-b64={emailB64} data-copy-label={t.contato.copiar}>{t.contato.revelar}</button></span></li>
      </ul>
      <a class="btn cv" href={curriculo(lang).href} download={curriculo(lang).nome}>{t.nav.cv}</a>
    </aside>
  </div>
  <canvas class="floor" data-eq data-count="96" data-gap="5" data-alpha="0.3" data-idle="0.5" aria-hidden="true"></canvas>
</div>

<style>
  .menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: var(--bg);
    overflow-y: auto;
    visibility: hidden;
    opacity: 0;
    transform: translateX(16px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s linear 0.25s;
  }
  .menu[data-open] {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .top {
    height: var(--header);
    padding-inline: var(--pad);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid var(--border);
    max-width: 100%;
  }
  .close {
    justify-self: start;
    font: 500 15px var(--body);
  }
  .brand {
    font: 600 22px var(--display);
    letter-spacing: 6px;
  }
  .lang {
    justify-self: end;
    display: flex;
    gap: 18px;
    font: 500 13px var(--mono);
    color: var(--muted);
  }
  .lang a {
    padding-block: 6px;
  }
  .lang a:hover {
    color: var(--text);
  }
  .lang a.on {
    color: var(--accent);
  }
  .body {
    max-width: 1440px;
    margin: 0 auto;
    padding: 34px var(--pad) 140px;
    display: grid;
    grid-template-columns: minmax(0, 760px) minmax(0, 496px);
    gap: 56px;
    justify-content: space-between;
    align-items: start;
  }
  .items {
    border-top: 1px solid var(--border);
  }
  .item {
    position: relative;
    display: grid;
    grid-template-columns: 96px 1fr auto auto;
    align-items: center;
    height: 112px;
    padding-inline: 28px;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s ease;
  }
  .item:hover {
    background: var(--surface);
  }
  .num {
    font: 400 13px var(--mono);
    color: var(--muted);
  }
  .name {
    font: 300 clamp(56px, 6vw, 76px) / 1 var(--display);
  }
  .desc {
    font: 400 12px var(--mono);
    color: var(--muted);
    white-space: nowrap;
  }
  .arrow {
    font-size: 30px;
    color: var(--accent);
    margin-left: 20px;
  }
  .item.ativo {
    background: var(--surface);
  }
  .item.ativo::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--accent);
  }
  .item.ativo .name,
  .item.ativo .num,
  .item.ativo .desc {
    color: var(--accent);
  }
  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 28px 32px 32px;
  }
  .contacts {
    list-style: none;
    margin: 14px 0 22px;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .contacts li {
    display: grid;
    grid-template-columns: 100px 1fr;
    align-items: baseline;
  }
  .key {
    font: 400 13px var(--mono);
    color: var(--muted);
  }
  .contacts a {
    font-size: 16px;
  }
  .contacts a:hover {
    color: var(--accent);
  }
  .reveal {
    font: 400 13px var(--mono);
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 3px 10px;
  }
  .cv {
    width: 100%;
    border-radius: 6px;
  }
  .floor {
    position: fixed;
    inset: auto 0 0 0;
    width: 100%;
    height: 80px;
    pointer-events: none;
    z-index: -1;
  }
  @media (max-width: 960px) {
    .body {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
  @media (max-width: 768px) {
    .brand {
      font-size: 18px;
      letter-spacing: 4px;
    }
    .lang {
      gap: 10px;
      font-size: 12px;
    }
    .body {
      padding-top: 16px;
    }
    .item {
      grid-template-columns: 40px 1fr auto auto;
      height: 76px;
      padding-inline: 16px;
    }
    .name {
      font-size: 48px;
    }
    .desc {
      font-size: 10px;
    }
    .arrow {
      font-size: 20px;
      margin-left: 10px;
    }
    .panel {
      padding: 20px;
    }
    .floor {
      height: 56px;
    }
  }
</style>

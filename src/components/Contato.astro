---
import { links, emailB64, curriculo } from '../data/contato';
---
<section id="contato" class="wrap sec">
  <p class="kicker">05 / Contato</p>
  <div class="grid">
    <div class="left">
      <h2 class="display">Vamos<br />conversar.</h2>
      <p class="muted">Respondo por e-mail ou LinkedIn.<br />O currículo está logo abaixo.</p>
    </div>

    <div class="term" role="group" aria-label="Contato em formato de terminal">
      <div class="titlebar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="ttl">pedro@portfolio: ~/contato</span>
      </div>
      <div class="body">
        <p class="cmd"><span class="p">$</span> contact --list</p>
        <ul class="out">
          {links.map((l) => (
            <li>
              <span class="key">{l.chave}</span>
              <a href={l.href} target="_blank" rel="noopener noreferrer">
                <span class="long">{l.rotulo === 'LinkedIn' ? 'linkedin.com/' + l.curto : l.chave === 'github' ? 'github.com/' + l.curto : l.curto}</span>
                <span class="short">{l.curto}</span>
                <span aria-hidden="true"> ↗</span>
              </a>
            </li>
          ))}
          <li>
            <span class="key">email</span>
            <span class="email-line"><button type="button" class="reveal" data-email-reveal data-b64={emailB64}>[ revelar e-mail ]</button></span>
          </li>
        </ul>
        <p class="cmd"><span class="p">$</span> contact --cv</p>
        <ul class="out">
          <li>
            <span class="key">curriculo.pdf</span>
            <a class="dl" href={curriculo} download>[ baixar ]</a>
          </li>
        </ul>
        <p class="status" data-copy-status aria-live="polite"></p>
        <p class="cmd"><span class="p">$</span> <span class="cursor" aria-hidden="true"></span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .sec {
    padding-top: 90px;
    padding-bottom: 100px;
  }
  .grid {
    margin-top: 36px;
    display: grid;
    grid-template-columns: minmax(300px, 1fr) minmax(0, 816px);
    gap: 56px;
    align-items: start;
  }
  .dl {
    justify-self: start;
  }
  @media (max-width: 1180px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  h2 {
    font-size: clamp(64px, 8.4vw, 120px);
  }
  .muted {
    margin: 36px 0 0;
    color: var(--muted);
    line-height: 1.5;
  }
  .term {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    font: 400 15px/1.4 var(--mono);
    overflow: hidden;
  }
  .titlebar {
    display: flex;
    align-items: center;
    height: 44px;
    padding-inline: 20px;
    border-bottom: 1px solid var(--border);
    position: relative;
  }
  .dots {
    display: flex;
    gap: 8px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border: 1px solid var(--muted);
    border-radius: 50%;
  }
  .ttl {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 12px;
    color: var(--muted);
    pointer-events: none;
  }
  .body {
    padding: 28px 28px 36px;
  }
  .cmd {
    margin: 0 0 14px;
  }
  .cmd:not(:first-child) {
    margin-top: 22px;
  }
  .p {
    color: var(--accent);
    font-weight: 700;
    margin-right: 10px;
  }
  .out {
    list-style: none;
    margin: 0;
    padding: 0 0 0 24px;
    display: grid;
    gap: 10px;
  }
  .out li {
    display: grid;
    grid-template-columns: 124px 1fr;
    align-items: baseline;
  }
  .key {
    color: var(--muted);
  }
  .out a:hover {
    color: var(--accent);
  }
  .short {
    display: none;
  }
  .reveal,
  .dl {
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 3px 12px;
    font: inherit;
    display: inline-block;
  }
  .reveal:hover,
  .dl:hover {
    background: var(--accent);
    color: var(--bg);
  }
  :global(.email-addr) {
    margin-right: 28px;
  }
  :global(.email-copy) {
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    border-radius: 4px;
    padding: 3px 12px;
  }
  .status {
    margin: 18px 0 0 24px;
    min-height: 1.4em;
    font-size: 13px;
    color: var(--accent);
  }
  .cursor {
    display: inline-block;
    width: 9px;
    height: 18px;
    background: var(--accent);
    vertical-align: text-bottom;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 768px) {
    .sec {
      padding-top: 56px;
      padding-bottom: 72px;
    }
    .term {
      font-size: 12px;
    }
    .body {
      padding: 20px 16px 24px;
    }
    .out {
      padding-left: 18px;
    }
    .out li {
      grid-template-columns: 84px 1fr;
    }
    .long {
      display: none;
    }
    .short {
      display: inline;
    }
    .status {
      margin-left: 18px;
    }
    :global(.email-addr) {
      display: block;
      margin: 0 0 8px;
      word-break: break-all;
    }
  }
</style>

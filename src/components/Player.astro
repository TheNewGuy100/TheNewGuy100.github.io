---
---
<div class="player" role="region" aria-label="Player">
  <button class="play" type="button" data-sound-toggle aria-pressed="false" aria-label="Tocar ou pausar a trilha">
    <span data-play-icon aria-hidden="true">▶</span>
  </button>
  <div class="meta">
    <span class="label np">Now playing</span>
    <span class="track">Faixa 01 — título da música</span>
  </div>
  <canvas class="mini" data-eq data-count="24" data-gap="2" data-idle="0.55" aria-hidden="true"></canvas>
</div>

<style>
  .player {
    position: fixed;
    inset: auto 0 0 0;
    height: var(--player);
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 20px;
    padding-inline: var(--pad);
    background: var(--surface);
    border-top: 1px solid var(--border);
  }
  .play {
    width: 32px;
    height: 32px;
    font-size: 14px;
    color: var(--text);
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .np {
    font-size: 11px;
  }
  .track {
    font-size: 15px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mini {
    margin-left: auto;
    width: 140px;
    height: 30px;
  }
  @media (max-width: 768px) {
    .player {
      gap: 14px;
    }
    .track {
      font-size: 13px;
    }
    .np {
      font-size: 10px;
    }
    .mini {
      width: 96px;
      height: 24px;
    }
  }
</style>

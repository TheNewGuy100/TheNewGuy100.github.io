---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const todos = (await getCollection('projetos')).sort((a, b) => a.data.ordem - b.data.ordem);
  return todos
    .map((p, i) => ({ p, i }))
    .filter(({ p }) => !p.data.paginaPropria)
    .map(({ p, i }) => ({
      params: { slug: p.id },
      props: { projeto: p, indice: i + 1, total: todos.length, anterior: todos[i - 1], proximo: todos[i + 1] },
    }));
}

const { projeto, indice, total, anterior, proximo } = Astro.props;
const { Content } = await render(projeto);
const d = projeto.data;
---
<Base title={`${d.titulo} · Pedro Henrique Bohn Costa`} description={d.resumo}>
  <div class="wrap page">
    <div class="top">
      <a class="back" href="/projetos/">← Projetos</a>
      <span class="idx">{String(indice).padStart(2, '0')} / {String(total).padStart(2, '0')}</span>
    </div>
    <h1 class="display">{d.titulo}.</h1>
    {d.tagline && <p class="tagline">{d.tagline}</p>}

    <dl class="meta">
      <div><dt class="label">Status</dt><dd class="ok">{d.status}</dd></div>
      <div><dt class="label">Stack</dt><dd>{d.stack.join(' · ')}</dd></div>
      <div><dt class="label">Tipo</dt><dd>{d.tipo}</dd></div>
      {d.repo && <div><dt class="label">Código</dt><dd><a href={d.repo} target="_blank" rel="noopener noreferrer">{d.repo.replace('https://', '')} ↗</a></dd></div>}
    </dl>

    <section class="about">
      <p class="kicker">01 / Sobre o projeto</p>
      <div class="display text"><Content /></div>
    </section>

    {d.destaques.length > 0 && (
      <section>
        <p class="kicker">02 / O que faz</p>
        <ul class="cards">
          {d.destaques.map((c, i) => (
            <li>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="display">{c.titulo}</h3>
              <p>{c.texto}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <nav class="pager" aria-label="Outros projetos">
      <div>
        <p class="label">Anterior</p>
        {anterior ? <a class="display" href={`/projetos/${anterior.id}/`}>← {anterior.data.titulo}</a> : <span class="display none">—</span>}
      </div>
      <div class="r">
        <p class="label">Próximo</p>
        {proximo ? <a class="display" href={`/projetos/${proximo.id}/`}>{proximo.data.titulo} →</a> : <span class="display none">—</span>}
      </div>
    </nav>
  </div>
</Base>

<style>
  .page {
    padding-top: 40px;
    padding-bottom: 96px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    font: 400 13px var(--mono);
  }
  .back {
    color: var(--muted);
  }
  .back:hover {
    color: var(--accent);
  }
  .idx {
    color: var(--accent);
    letter-spacing: 2px;
  }
  h1 {
    font-size: clamp(76px, 10vw, 132px);
    margin: 24px 0 18px;
  }
  .tagline {
    font: 400 16px var(--mono);
    letter-spacing: 2px;
    color: var(--accent);
    margin: 0 0 44px;
  }
  .meta {
    margin: 0 0 56px;
    padding: 24px 0;
    border-block: 1px solid var(--border);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px;
  }
  dt {
    margin-bottom: 6px;
  }
  dd {
    margin: 0;
    font-size: 17px;
  }
  dd a:hover {
    color: var(--accent);
  }
  .ok {
    color: var(--accent);
  }
  .about,
  section + section {
    margin-top: 72px;
  }
  .text {
    margin-top: 28px;
    max-width: 900px;
    font-size: clamp(28px, 3.1vw, 44px);
    line-height: 1.1;
  }
  .text :global(p) {
    margin: 0 0 20px;
  }
  .cards {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .cards li {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }
  .n {
    font: 400 12px var(--mono);
    color: var(--accent);
  }
  .cards h3 {
    font-size: 36px;
    font-weight: 400;
    margin: 10px 0 12px;
  }
  .cards p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .pager {
    margin-top: 88px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }
  .pager .display {
    display: block;
    margin-top: 10px;
    font-size: 36px;
    font-weight: 400;
  }
  .pager a:hover {
    color: var(--accent);
  }
  .r {
    text-align: right;
  }
  .none {
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 768px) {
    .page {
      padding-top: 24px;
    }
    h1 {
      font-size: 76px;
    }
    .meta {
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
    .pager .display {
      font-size: 26px;
    }
  }
</style>

---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projetos = await getCollection('projetos');
  return projetos.map((p) => ({ params: { slug: p.id }, props: { projeto: p } }));
}

const { projeto } = Astro.props;
const { Content } = await render(projeto);
const { titulo, resumo, stack, repo, demo } = projeto.data;
---
<Base title={`${titulo} · Pedro Henrique Bohn Costa`} description={resumo}>
  <p><a href="/#projetos">← Projetos</a></p>
  <h1>{titulo}</h1>
  <p class="lead">{resumo}</p>
  <ul class="tags">{stack.map((s) => <li>{s}</li>)}</ul>
  <div class="links">
    {repo && <a href={repo}>Repositório</a>}
    {demo && <a href={demo}>Demo</a>}
  </div>
  <Content />
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Tile from '../../../components/Tile.astro';
import { getLang, href, langPaths, pad } from '../../../i18n';
import { ui } from '../../../i18n/ui';

export function getStaticPaths() {
  return langPaths();
}

const lang = getLang(Astro.url);
const ti = ui(lang);
const t = ti.vibedeck;
const todos = (await getCollection('projetos')).sort((a, b) => a.data.ordem - b.data.ordem);
const idx = todos.findIndex((p) => p.id === 'vibedeck');
const anterior = todos[idx - 1];

const funcionalidades = t.funcionalidades;
const tecnologias = [
  { nome: 'Tauri', slug: 'tauri' },
  { nome: 'Vue', slug: 'vuedotjs' },
  { nome: 'TypeScript', slug: 'typescript' },
  { nome: 'Rust', mono: 'Rs' },
  { nome: 'Vite', slug: 'vite' },
];
---
<Base title="VibeDeck · Pedro Henrique Bohn Costa" description={t.seoDescricao}>
  <div class="wrap page">
    <div class="top">
      <a class="back" href={href(lang, '/projetos/')}>{ti.projeto.voltar}</a>
      <span class="idx">{pad(idx + 1)} / {pad(todos.length)}</span>
    </div>
    <h1 class="display">VibeDeck.</h1>
    <p class="tagline">Tauri · Vue · Rust</p>

    <dl class="meta">
      <div><dt class="label">{ti.projeto.status}</dt><dd class="ok">{ti.status['em desenvolvimento']}</dd></div>
      <div><dt class="label">{ti.projeto.stack}</dt><dd>Tauri · Vue · Rust</dd></div>
      <div><dt class="label">{ti.projeto.plataforma}</dt><dd>{t.plataforma}</dd></div>
      <div><dt class="label">{ti.projeto.tipo}</dt><dd>{ti.tipos['Projeto pessoal']}</dd></div>
    </dl>

    <!-- O som do site só existe aqui: a trilha e o equalizador pertencem ao VibeDeck. -->
    <div class="sound" role="group" aria-label={t.somAria}>
      <canvas id="vd-eq" class="eq3d" aria-hidden="true"></canvas>
      <button class="btn ghost listen" type="button" data-sound-toggle aria-pressed="false">
        <span aria-hidden="true">♪</span>&nbsp;
        <span data-sound-label data-on={t.somPausar} data-off={t.somOuvir}>{t.somOuvir}</span>
      </button>
    </div>

    <figure class="app" aria-label={t.ilustracaoAria}>
      <div class="bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="t">VibeDeck</span></div>
      <div class="inner">
        <aside>
          <p class="label">{t.biblioteca}</p>
          <ul>{t.itens.map((item, i) => <li class={i === 0 ? 'on' : undefined}>{item}</li>)}</ul>
        </aside>
        <div class="queue">
          <p class="label">{t.fila}</p>
          {[0, 1, 2, 3, 4, 5].map((i) => (
            <div class="line">
              <span class="cv"></span>
              <span class="ls"><i style={`width:${42 + ((i * 47) % 40)}%`}></i><i class="s" style={`width:${24 + ((i * 31) % 28)}%`}></i></span>
              <span class="tm"></span>
            </div>
          ))}
        </div>
      </div>
      <div class="pl"><span class="pbtn"></span><span class="prog"><i></i></span><span class="vol"><i></i></span></div>
      <figcaption class="label">{t.ilustracaoLegenda}</figcaption>
    </figure>

    <section class="about">
      <p class="kicker">{t.sobre}</p>
      <p class="display text">{t.texto}</p>
    </section>

    <section>
      <p class="kicker">{t.funcKicker}</p>
      <ul class="feats">
        {funcionalidades.map(([titulo, desc], i) => (
          <li>
            <span class="n">{pad(i + 1)}</span>
            <strong>{titulo}</strong>
            <span class="d">{desc}</span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <p class="kicker">{t.tecKicker}</p>
      <ul class="tiles">
        {tecnologias.map((tec) => <Tile nome={tec.nome} slug={tec.slug} mono={tec.mono} />)}
      </ul>
    </section>

    <section>
      <p class="kicker">{t.proxKicker}</p>
      <div class="next">
        <div>
          <strong>{t.proxTitulo}</strong>
          <p>{t.proxTexto}</p>
        </div>
        <span class="chip">{t.planejado}</span>
      </div>
      <p class="note">{t.nota}</p>
    </section>

    <nav class="pager" aria-label={ti.projeto.outros}>
      <div>
        <p class="label">{ti.projeto.anterior}</p>
        {anterior ? <a class="display" href={href(lang, `/projetos/${anterior.id}/`)}>← {anterior.data.titulo}</a> : <span class="display none">—</span>}
      </div>
      <div class="r">
        <p class="label">{ti.projeto.proximo}</p>
        <span class="display none">—</span>
      </div>
    </nav>
  </div>
</Base>

<script>
  import { startEq3D } from '../../../scripts/eq';

  function boot(): void {
    const canvas = document.getElementById('vd-eq') as HTMLCanvasElement | null;
    if (!canvas || canvas.dataset.started) return;
    canvas.dataset.started = '1';
    startEq3D(canvas);
  }
  document.addEventListener('astro:page-load', boot);
  boot();
</script>

<style>
  .page {
    padding-top: 40px;
    padding-bottom: 96px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    font: 400 13px var(--mono);
  }
  .back {
    color: var(--muted);
  }
  .back:hover {
    color: var(--accent);
  }
  .idx {
    color: var(--accent);
    letter-spacing: 2px;
  }
  h1 {
    font-size: clamp(76px, 10vw, 132px);
    margin: 24px 0 18px;
  }
  .tagline {
    font: 400 16px var(--mono);
    letter-spacing: 2px;
    color: var(--accent);
    margin: 0 0 44px;
  }
  .meta {
    margin: 0 0 48px;
    padding: 24px 0;
    border-block: 1px solid var(--border);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px;
  }
  dt {
    margin-bottom: 6px;
  }
  dd {
    margin: 0;
    font-size: 17px;
  }
  .ok {
    color: var(--accent);
  }
  .sound {
    position: relative;
    height: clamp(200px, 26vh, 260px);
    margin: 0 0 48px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .eq3d {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .listen {
    position: absolute;
    top: 20px;
    left: 20px;
    height: 40px;
    padding-inline: 20px;
    font: 500 14px var(--mono);
    background: var(--bg);
  }
  .listen.is-on {
    color: var(--accent);
    border-color: var(--accent);
  }
  .app {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    height: 44px;
    padding-inline: 20px;
    border-bottom: 1px solid var(--border);
  }
  .dots {
    display: flex;
    gap: 8px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border: 1px solid var(--muted);
    border-radius: 50%;
  }
  .t {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font: 400 12px var(--mono);
    color: var(--muted);
  }
  .inner {
    display: grid;
    grid-template-columns: 220px 1fr;
    min-height: 440px;
  }
  aside {
    padding: 24px;
    border-right: 1px solid var(--border);
  }
  aside ul {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
    display: grid;
    gap: 14px;
    font-size: 14px;
  }
  aside .on {
    color: var(--accent);
  }
  .queue {
    padding: 24px;
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .line {
    display: grid;
    grid-template-columns: 36px 1fr 48px;
    align-items: center;
    gap: 16px;
  }
  .cv {
    width: 36px;
    height: 36px;
    border-radius: 4px;
    background: var(--border);
  }
  .ls {
    display: grid;
    gap: 8px;
  }
  .ls i,
  .tm {
    display: block;
    height: 8px;
    border-radius: 2px;
    background: var(--border);
  }
  .ls i.s {
    height: 6px;
    opacity: 0.55;
  }
  .tm {
    height: 6px;
    opacity: 0.55;
  }
  .pl {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 72px;
    padding-inline: 24px;
    border-top: 1px solid var(--border);
  }
  .pbtn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent);
  }
  .prog,
  .vol {
    position: relative;
    height: 4px;
    border-radius: 2px;
    background: var(--border);
  }
  .prog {
    flex: 1;
  }
  .vol {
    width: 120px;
  }
  .prog i,
  .vol i {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 2px;
    background: var(--accent);
  }
  .prog i {
    width: 36%;
  }
  .vol i {
    width: 58%;
  }
  figcaption {
    text-align: right;
    padding: 10px 16px;
    font-size: 11px;
  }
  .about,
  section + section {
    margin-top: 72px;
  }
  .about {
    margin-top: 64px;
  }
  .text {
    margin-top: 28px;
    max-width: 900px;
    font-size: clamp(28px, 3.1vw, 44px);
    line-height: 1.1;
  }
  .feats {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .feats li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 132px;
    padding: 22px 24px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }
  .n {
    font: 400 12px var(--mono);
    color: var(--accent);
  }
  .feats strong {
    font: 500 18px var(--body);
  }
  .d {
    color: var(--muted);
    font-size: 14px;
  }
  .tiles {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 136px);
    gap: 12px;
  }
  .next {
    margin-top: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 22px 24px;
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .next strong {
    font: 500 18px var(--body);
  }
  .next p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 14px;
    max-width: 760px;
  }
  .chip {
    flex: none;
    padding: 5px 16px;
    border: 1px solid var(--border);
    border-radius: 14px;
    font: 400 12px var(--mono);
    color: var(--muted);
  }
  .note {
    margin: 16px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
  .pager {
    margin-top: 88px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }
  .pager .display {
    display: block;
    margin-top: 10px;
    font-size: 36px;
    font-weight: 400;
  }
  .pager a:hover {
    color: var(--accent);
  }
  .r {
    text-align: right;
  }
  .none {
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .feats {
      grid-template-columns: repeat(2, 1fr);
    }
    .inner {
      grid-template-columns: 1fr;
    }
    aside {
      display: none;
    }
  }
  @media (max-width: 768px) {
    .page {
      padding-top: 24px;
    }
    h1 {
      font-size: 76px;
    }
    .meta {
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
    .tiles {
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }
    .feats {
      gap: 12px;
    }
    .feats li {
      min-height: 116px;
      padding: 16px;
    }
    .feats strong {
      font-size: 15px;
    }
    .d {
      font-size: 12px;
    }
    .next {
      flex-direction: column;
      align-items: flex-start;
    }
    .pager .display {
      font-size: 26px;
    }
    .pl {
      height: 56px;
    }
    .vol {
      display: none;
    }
  }
</style>
